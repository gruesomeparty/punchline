{
  "manifest_version": 3,
  "name": "punchline",
  "description": "Syncs daily working hours from Harvest into HRworks.",
  "version": "0.0.0",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "punchline",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "side_panel": {
    "default_path": "days/days.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "https://api.harvestapp.com/*",
    "https://hrworks.de/*",
    "https://*.hrworks.de/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://hrworks.de/*", "https://*.hrworks.de/*"],
      "js": ["hrworks/content.js"],
      "run_at": "document_idle"
    }
  ]
}
